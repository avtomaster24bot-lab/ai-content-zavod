      "typeVersion": 4.2,
      "position": [
        980,
        40
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_OPENAI_HEADER_CRED",
          "name": "OpenAI Header Auth"
        }
