    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4.1-mini', temperature: 0, messages: [ { role: 'system', content: 'Ты строгий редактор. Библия стиля: 1) никаких выдуманных цифр и кейсов; 2) короткие фразы; 3) запрещены слова: инновационный, революционный, уникальный, нейросетка-волшебница; 4) не обещай охват и доход; 5) живой тон человека из Алматы, не буклет. Верни JSON с полями verdict (PASS или FAIL) и critique (кратко, по-русски).' }, { role: 'user', content: 'Тема: ' + $json.topic + '\\nЧерновик:\\n' + $json.draft } ] }) }}",
        "options": {}
      },
