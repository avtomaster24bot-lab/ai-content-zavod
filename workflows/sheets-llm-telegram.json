      "typeVersion": 3.4,
      "position": [
        740,
        40
      ],
      "notes": "Узел Edit Fields (раньше назывался Set). Документация: https://docs.n8n.io/integrations/builtin/core-nodes/n8n-nodes-base.set/"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4.1-mini', temperature: 0.4, messages: [ { role: 'system', content: 'Ты автор контента для Instagram личного бренда про нейросети. Пиши по-русски, коротко, без воды и без выдуманных цифр. Формат ответа: только готовый текст поста или сценарий карусели/Reels.' }, { role: 'user', content: 'Тема: ' + $json.topic + '\\nФормат: ' + $json.format + '\\nДля кого: ' + $json.audience + '\\nНапиши черновик. Если это карусель — пронумеруй слайды 1..N. Если Reels — хук, 3 пункта, призыв написать в директ.' } ] }) }}",
        "options": {}
      },
      "id": "7fbb1d88-8b6e-4df8-9c7f-61e3dd77c808",
      "name": "HTTP Request Draft Post",
